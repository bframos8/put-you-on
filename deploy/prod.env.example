# Template for the LOCAL prod values used to seed SSM (gameplan 5.1).
#   cp deploy/prod.env.example deploy/prod.env   # deploy/prod.env is gitignored
# then fill in real values and run ./deploy/ssm-seed.sh.
#
# This file (the .example) holds NO real values and is safe to commit. The copy you
# fill in (deploy/prod.env) holds live secrets and must NEVER be committed.
#
# Format: KEY=VALUE, one per line. Everything after the first '=' is the value
# (values may contain '=', '#', etc. — they are sent to SSM verbatim). Which keys are
# SecureString vs String is decided by ssm-seed.sh, not here. See ssm-parameters.md.
# DAILY_LIMIT_BYPASS is deliberately not listed — it must stay unset in prod.

# --- secrets (stored as SecureString) ---
SESSION_SECRET=
TOKEN_ENCRYPTION_KEYS=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SENTRY_DSN=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- config (stored as String) ---
POSTGRES_HOST=
POSTGRES_PORT=5432
SPOTIFY_REDIRECT_URI=https://putyouon.app/api/v1/auth/spotify/callback
FRONTEND_URL=https://putyouon.app
CORS_ALLOWED_ORIGINS=https://putyouon.app
ENABLE_HSTS=true

# --- optional config (code defaults exist; set only to override) ---
#SENTRY_ENVIRONMENT=production
#SENTRY_TRACES_SAMPLE_RATE=0.0
#SPOTIFY_HTTP_TIMEOUT=10.0
#OAUTH_STATE_TTL_SECONDS=600
#LOG_LEVEL=INFO
