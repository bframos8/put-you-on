# Copy to frontend/.env.local and fill in. That file is gitignored — do not commit it.
# This is the LOCAL DEV contract for the Next.js frontend.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so they
# cannot be corrected at runtime. In Docker they come from the build-arg in
# docker-compose.yaml, NOT from this file (frontend/.dockerignore keeps all .env*
# out of the build context on purpose, so there is only one source of truth).
# This file is for `npm run dev` on the host.

# Origin the browser calls for the API. With the nginx proxy on :443 this is the
# bare origin; against a directly-run uvicorn it is https://127.0.0.1:8000.
NEXT_PUBLIC_API_URL=https://127.0.0.1

# Dev-only escape hatch: "true" skips the Spotify login flow so you can work on
# authed pages without an OAuth round trip. Leave unset/false to exercise real auth.
NEXT_PUBLIC_DEV_BYPASS_AUTH=
