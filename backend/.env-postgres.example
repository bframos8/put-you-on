# Copy to ../.env-postgres (repo root) and fill in real values. Do not commit that file.
# Loaded into the backend container alongside .env-backend (see docker-compose.yaml).
# In production these are materialized from SSM Parameter Store at deploy (Phase 5).

# PostgreSQL connection used by the backend (app/db/database.py). DB, USER, and
# PASSWORD are REQUIRED (no code defaults). HOST/PORT default to localhost:5432.
# When running against a local db container, set POSTGRES_HOST to that service name.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
