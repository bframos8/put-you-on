# Copy to ../.env-backend (repo root) and fill in real values. Do not commit that file.

# Session cookie signing key — REQUIRED. App refuses to start if unset/blank.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Encryption key(s) for Spotify tokens at rest — REQUIRED. App AND alembic refuse
# to start if unset/blank (export it before `alembic upgrade head`). Comma-separated
# Fernet keys: the first encrypts new values; any listed key can decrypt (rotation).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# Spotify OAuth app credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/v1/auth/spotify/callback

# Frontend origin for OAuth redirect
FRONTEND_URL=https://127.0.0.1:3000

# Allowed CORS origins for the browser frontend (comma-separated, scheme+host+port,
# NO trailing path). Defaults to https://127.0.0.1:3000 if unset.
CORS_ALLOWED_ORIGINS=https://127.0.0.1:3000

# Timeout (seconds) for outbound Spotify API calls. Defaults to 10.0 if unset.
SPOTIFY_HTTP_TIMEOUT=10.0

# Lifetime (seconds) of an OAuth CSRF `state` before the callback rejects it.
# Defaults to 600 (10 min) if unset.
OAUTH_STATE_TTL_SECONDS=600

# Emit HSTS (Strict-Transport-Security). Enable ONLY where TLS terminates in
# front of the app (e.g. behind the nginx :443 proxy). Defaults to off.
ENABLE_HSTS=false

# Sentry error tracking. LEAVE BLANK to disable — the app skips Sentry init when
# unset, so local dev and tests never send events. Set only in production (from
# SSM at deploy). Get the DSN from your Sentry project.
SENTRY_DSN=

# Environment label attached to Sentry events. Defaults to "production" if unset.
# Only relevant when SENTRY_DSN is set.
SENTRY_ENVIRONMENT=production

# Fraction (0.0–1.0) of requests sampled for Sentry performance tracing. Defaults
# to 0.0 (errors only, no performance transactions) — aggregate latency/throughput
# lives in Grafana. Raise temporarily (e.g. 0.1) to investigate a slow endpoint.
SENTRY_TRACES_SAMPLE_RATE=0.0

# Dev-only escape hatch: set to "true" to DISABLE the once-per-day song dispatch
# limit so you can dispatch repeatedly while testing. Leave UNSET in production
# (the app logs a startup warning if it is enabled). Defaults to off (enforced).
DAILY_LIMIT_BYPASS=
