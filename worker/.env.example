# Template for the ingest worker's local config (gameplan 10.6).
#   cp worker/.env.example worker/.env     # worker/.env is gitignored
#
# This file holds NO real values and is safe to commit. The copy you fill in holds the
# worker token and the Spotify client secret, and must never be committed.
#
# These are the secrets that leave the AWS boundary. They are copied here by hand and
# there is no rotation story yet; if this machine is lost, rotate INGEST_WORKER_TOKEN in
# SSM (which locks the worker out immediately) and the Spotify credentials in the
# Spotify dashboard.

# Which app to work for. Use https://127.0.0.1 against a local docker compose stack.
PUTYOUON_API_URL=https://putyouon.app

# Must equal the INGEST_WORKER_TOKEN parameter under /putyouon/prod/. While that is
# unset on the server, every ingest endpoint answers 404 and this worker has no queue.
INGEST_WORKER_TOKEN=

# spotdl resolves the track URL through the Spotify API, so it needs its own credentials.
# Same values as the app's.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- optional, code defaults exist ---
# Seeds leased per claim. Keep it well under what fits in the server's 15-minute lease.
#WORKER_BATCH_SIZE=3
# Seconds between polls with work, and without.
#WORKER_BUSY_POLL_SECONDS=10
#WORKER_IDLE_POLL_SECONDS=60
#WORKER_HTTP_TIMEOUT=30
# ONLY for a local mkcert stack, which the system trusts but Python does not. Never set
# this against a real host: the bearer token goes out on every request.
#WORKER_VERIFY_TLS=true
